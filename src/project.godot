; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PES-trotter"
config/version="0.12.1"
run/main_scene="uid://br2m66dhim41b"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.3019608, 0.49411765, 0.7529412, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/splash.png"
config/icon="uid://dyxfchewci1hy"
config/windows_native_icon="res://assets/icon.ico"

[autoload]

Globals="*res://assets/data_classes/Globals.gd"
CriticalPoints="*res://assets/data_classes/CriticalPoints.gd"
UISounds="*res://assets/data_classes/UISounds.gd"

[display]

window/vsync/vsync_mode=0

[editor]

movie_writer/movie_file="C:/Users/Archaoss/OneDrive/Images/Captures d’écran/mesh-reader.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/FileAccessWeb/plugin.cfg", "res://addons/easy_charts/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://builds/": "pink",
"res://demo_pes/": "green",
"res://export/": "pink",
"res://test_pes/": "green"
}

[gui]

theme/custom="uid://cbb7usd6iskrc"

